generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MfaCredentialStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum RoleScope {
  ORGANIZATION
  BRANCH
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum SecurityAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SecurityAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SecurityAlertEventType {
  DETECTED
  OBSERVED
  REOPENED
  ACKNOWLEDGED
  RESOLVED
}

enum OperationalEvidenceKind {
  BACKUP
  RESTORE_DRILL
}

enum OperationalEvidenceOutcome {
  SUCCEEDED
  FAILED
}

enum OperationalEvidenceSource {
  LOCAL_ENCRYPTED_ARCHIVE
  MANAGED_PROVIDER
  MANUAL_EVIDENCE
}

