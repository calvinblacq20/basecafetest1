  @@index([organizationId, kind, completedAt])
  @@index([organizationId, outcome, recordedAt])
  @@index([recordedById, recordedAt])
  @@map("operational_evidence")
}

model CustomerProfile {
  id                       String                @id @db.Uuid
  organizationId           String                @map("organization_id") @db.Uuid
  status                   CustomerProfileStatus @default(ACTIVE)
  revision                 Int                   @default(1)
  piiCiphertext            Bytes?                @map("pii_ciphertext") @db.ByteA
  piiIv                    Bytes?                @map("pii_iv") @db.ByteA
  piiAuthTag               Bytes?                @map("pii_auth_tag") @db.ByteA
  piiKeyVersion            String?               @map("pii_key_version") @db.VarChar(40)
  phoneBlindIndex          String?               @map("phone_blind_index") @db.Char(64)
  emailBlindIndex          String?               @map("email_blind_index") @db.Char(64)
  legalHoldUntil           DateTime?             @map("legal_hold_until") @db.Timestamptz(3)
  createdById              String                @map("created_by_id") @db.Uuid
  anonymizedById           String?               @map("anonymized_by_id") @db.Uuid
  anonymizedAt             DateTime?             @map("anonymized_at") @db.Timestamptz(3)
  lastOperationalContactAt DateTime?             @map("last_operational_contact_at") @db.Timestamptz(3)
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User                      @relation("CustomerProfileCreator", fields: [createdById], references: [id], onDelete: Restrict)
  anonymizedBy    User?                     @relation("CustomerProfileAnonymizer", fields: [anonymizedById], references: [id], onDelete: Restrict)
  orderContacts   OrderCustomerContact[]
  consents        CustomerConsentEvent[]
  accessEvents    CustomerDataAccessEvent[]
  privacyRequests PrivacyRequest[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, phoneBlindIndex])
  @@index([organizationId, emailBlindIndex])
  @@index([createdById, createdAt])
  @@map("customer_profiles")
}

model OrderCustomerContact {
  orderId         String    @id @map("order_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  customerId      String?   @map("customer_id") @db.Uuid
  piiCiphertext   Bytes?    @map("pii_ciphertext") @db.ByteA
  piiIv           Bytes?    @map("pii_iv") @db.ByteA
  piiAuthTag      Bytes?    @map("pii_auth_tag") @db.ByteA
  piiKeyVersion   String?   @map("pii_key_version") @db.VarChar(40)
  phoneBlindIndex String?   @map("phone_blind_index") @db.Char(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  anonymizedAt    DateTime? @map("anonymized_at") @db.Timestamptz(3)

  order        Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer     CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([organizationId, customerId, createdAt])
  @@index([branchId, phoneBlindIndex])
  @@map("order_customer_contacts")
}

model CustomerConsentEvent {
  id             String                 @id @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  customerId     String                 @map("customer_id") @db.Uuid
  purpose        CustomerConsentPurpose
  channel        CustomerContactChannel
  status         CustomerConsentStatus
  source         String                 @db.VarChar(80)
  wordingVersion String                 @map("wording_version") @db.VarChar(80)
  actorId        String                 @map("actor_id") @db.Uuid
  reason         String                 @db.VarChar(500)
  occurredAt     DateTime               @map("occurred_at") @db.Timestamptz(3)
  recordedAt     DateTime               @default(now()) @map("recorded_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actor        User            @relation("CustomerConsentActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, customerId, purpose, channel, occurredAt])
  @@index([actorId, recordedAt])
  @@map("customer_consent_events")
}

model CustomerDataAccessEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  accessType     String   @map("access_type") @db.VarChar(40)
  resourceType   String   @map("resource_type") @db.VarChar(60)
  resourceId     String   @map("resource_id") @db.VarChar(100)
  fields         Json
  reason         String   @db.VarChar(500)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actor        User             @relation("CustomerDataAccessActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("customer_data_access_events")
}

model PrivacyRequest {
  id                   String               @id @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  customerId           String               @map("customer_id") @db.Uuid
  requestType          PrivacyRequestType   @map("request_type")
  status               PrivacyRequestStatus @default(RECEIVED)
  revision             Int                  @default(1)
  dueAt                DateTime?            @map("due_at") @db.Timestamptz(3)
  createdById          String               @map("created_by_id") @db.Uuid
  identityVerifiedById String?              @map("identity_verified_by_id") @db.Uuid
  identityVerifiedAt   DateTime?            @map("identity_verified_at") @db.Timestamptz(3)
  completedById        String?              @map("completed_by_id") @db.Uuid
  completedAt          DateTime?            @map("completed_at") @db.Timestamptz(3)
  reason               String               @db.VarChar(500)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer           CustomerProfile       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy          User                  @relation("PrivacyRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  identityVerifiedBy User?                 @relation("PrivacyRequestVerifier", fields: [identityVerifiedById], references: [id], onDelete: Restrict)
  completedBy        User?                 @relation("PrivacyRequestCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  events             PrivacyRequestEvent[]

  @@index([organizationId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("privacy_requests")
}

model PrivacyRequestEvent {
  id         String                @id @default(uuid()) @db.Uuid
  requestId  String                @map("request_id") @db.Uuid
  fromStatus PrivacyRequestStatus? @map("from_status")
  toStatus   PrivacyRequestStatus  @map("to_status")
  actorId    String                @map("actor_id") @db.Uuid
  reason     String                @db.VarChar(500)
  occurredAt DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)

  request PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User           @relation("PrivacyRequestEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("privacy_request_events")
}

model RetentionPolicyVersion {
  id                String                @id @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  category          RetentionCategory
  version           Int
  durationDays      Int                   @map("duration_days")
  status            RetentionPolicyStatus @default(DRAFT)
  revision          Int                   @default(1)
  effectiveFrom     DateTime?             @map("effective_from") @db.Timestamptz(3)
  approvalReference String?               @map("approval_reference") @db.VarChar(160)
  createdById       String                @map("created_by_id") @db.Uuid
  activatedById     String?               @map("activated_by_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  activatedAt       DateTime?             @map("activated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("RetentionPolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activatedBy  User?        @relation("RetentionPolicyActivator", fields: [activatedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, category, version])
  @@index([organizationId, category, status, effectiveFrom])
  @@map("retention_policy_versions")
}
