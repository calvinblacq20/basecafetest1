enum OrderEventType {
  CREATED
  HELD
  RESUMED
  CANCELLED
  LINE_ADDED
  LINE_REPLACED
  LINE_REMOVED
  TABLE_CONFLICT_OVERRIDDEN
  SEND_WAVE_CREATED
  SENT_LINE_CANCELLED
  TABLE_MOVED
  RESPONSIBILITY_TRANSFERRED
  MERGED_INTO
  MERGE_RECEIVED
  SPLIT_CREATED
  SPLIT_RECEIVED
  COMPLETED
