  KITCHEN
  BAR
  OTHER
}

enum RecipeStatus {
  DRAFT
  ACTIVE
  CANCELLED
}

enum StockLedgerType {
  OPENING_BALANCE
  MANUAL_ADJUSTMENT
  WASTE
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_ADJUSTMENT
  SALE_CONSUMPTION
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  PRODUCTION_INPUT
  PRODUCTION_OUTPUT
  REVERSAL
}

enum StockCountStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum InventoryDeductionTrigger {
  SENT
  PREPARED
  SERVED
  COMPLETED
}

enum InventoryPolicyStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  CANCELLED
}

enum ModifierInventoryEffectKind {
  ADD
  REMOVE
  REPLACE_ADD
  REPLACE_REMOVE
}

enum AvailabilityTargetKind {
  ITEM
  VARIANT
  MODIFIER
}

enum ManualAvailabilityState {
  UNAVAILABLE
  RESTORED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches                 Branch[]
  devices                  Device[]
  users                    User[]
  roles                    Role[]
  auditLogs                AuditLog[]
  inventoryUnits           InventoryUnit[]
  inventoryUnitConversions InventoryUnitConversion[]
  syncCommandReceipts      SyncCommandReceipt[]
  operationalEvidence      OperationalEvidence[]
  customerProfiles         CustomerProfile[]
  orderCustomerContacts    OrderCustomerContact[]
  customerConsentEvents    CustomerConsentEvent[]
  customerDataAccessEvents CustomerDataAccessEvent[]
  privacyRequests          PrivacyRequest[]
  retentionPolicies        RetentionPolicyVersion[]
  securityAlerts           SecurityAlert[]
  auditIntegrityBatches    AuditIntegrityBatch[]
  pilotReadinessEvidence   PilotReadinessEvidence[]
  pilotReadinessReviews    PilotReadinessReview[]
  mfaCredentials           UserMfaCredential[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(160)
  timezone       String   @default("Africa/Accra") @db.VarChar(64)
  currency       String   @default("GHS") @db.Char(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  devices            Device[]
  userRoles          UserRole[]
  categories         Category[]
  stations           Station[]
  menuItems          MenuItem[]
  prices             MenuPrice[]
  taxClasses         TaxClass[]
  taxProfiles        TaxProfile[]
  modifierGroups     ModifierGroup[]
  auditLogs          AuditLog[]
  catalogImports     CatalogImport[]
  diningAreas        DiningArea[]
  diningTables       DiningTable[]
  schedules          BranchScheduleVersion[]
  specialHours       BranchSpecialHours[]
  staffShifts        StaffShift[]
  orders             Order[]
  orderSendWaves     OrderSendWave[]
  preparationTickets PreparationTicket[]
  orderSequences     BranchOrderSequence[]

  orderTableMovements           OrderTableMovement[]
  orderResponsibilityTransfers  OrderResponsibilityTransfer[]
  orderMerges                   OrderMerge[]
  orderSplits                   OrderSplit[]
  payments                      Payment[]
  receiptSequences              BranchReceiptSequence[]
  receipts                      Receipt[]
  fiscalDocuments               FiscalDocument[]
  printJobs                     PrintJob[]
  refunds                       Refund[]
  cashMovements                 CashMovement[]
  stockLocations                StockLocation[]
  inventoryItems                InventoryItem[]
  recipeVersions                RecipeVersion[]
  stockLedgerEntries            StockLedgerEntry[]
  inventoryTransfers            InventoryTransfer[]
  stockCounts                   StockCount[]
  suppliers                     Supplier[]
  purchaseOrders                PurchaseOrder[]
  goodsReceipts                 GoodsReceipt[]
  purchaseReturns               PurchaseReturn[]
  inventoryDeductionPolicies    InventoryDeductionPolicyVersion[]
  inventoryConsumptionRoutes    InventoryConsumptionRouteVersion[]
  inventoryConsumptions         InventoryConsumption[]
  inventoryConsumptionReversals InventoryConsumptionReversal[]
  modifierRecipeEffects         ModifierRecipeEffectVersion[]
  batchRecipeVersions           BatchRecipeVersion[]
  batchProductions              BatchProduction[]
  batchProductionReversals      BatchProductionReversal[]
  criticalIngredientRules       CriticalIngredientRuleVersion[]
  criticalIngredientComponents  CriticalIngredientRuleComponent[]
  manualAvailabilityEvents      ManualAvailabilityEvent[]
  syncCommandReceipts           SyncCommandReceipt[]
  orderCustomerContacts         OrderCustomerContact[]
  securityAlerts                SecurityAlert[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("branches")
}

model Device {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  branchId        String       @map("branch_id") @db.Uuid
  name            String       @db.VarChar(120)
  status          DeviceStatus @default(PENDING)
  revision        Int          @default(1)
  fingerprintHash String?      @unique @map("fingerprint_hash") @db.VarChar(128)
  enrolledAt      DateTime?    @map("enrolled_at") @db.Timestamptz(3)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization                  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                        Branch                         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sessions                      Session[]
  staffShifts                   StaffShift[]
  orders                        Order[]
  orderTableMovements           OrderTableMovement[]
  orderResponsibilityTransfers  OrderResponsibilityTransfer[]
  orderMerges                   OrderMerge[]
  orderSplits                   OrderSplit[]
  payments                      Payment[]
  inventoryConsumptions         InventoryConsumption[]         @relation("InventoryConsumptionDevice")
  inventoryConsumptionReversals InventoryConsumptionReversal[] @relation("InventoryConsumptionReversalDevice")
  batchProductions              BatchProduction[]              @relation("BatchProductionDevice")
  batchProductionReversals      BatchProductionReversal[]      @relation("BatchProductionReversalDevice")
  manualAvailabilityEvents      ManualAvailabilityEvent[]      @relation("ManualAvailabilityEventDevice")
  syncCommandReceipts           SyncCommandReceipt[]

  @@unique([organizationId, name])
  @@index([branchId, status])
  @@map("devices")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  email              String     @db.VarChar(254)
  displayName        String     @map("display_name") @db.VarChar(120)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  revision           Int        @default(1)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization                     Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles                            UserRole[]
  sessions                         Session[]
  auditEvents                      AuditLog[]                         @relation("AuditActor")
  assignments                      UserRole[]                         @relation("RoleAssigner")
  revocations                      UserRole[]                         @relation("RoleRevoker")
  idempotency                      IdempotencyRecord[]
  createdPrices                    MenuPrice[]
  catalogImports                   CatalogImport[]
  createdTaxProfiles               TaxProfile[]                       @relation("TaxProfileCreator")
  confirmedTaxProfiles             TaxProfile[]                       @relation("TaxProfileConfirmationRecorder")
  activatedTaxProfiles             TaxProfile[]                       @relation("TaxProfileActivator")
  createdSchedules                 BranchScheduleVersion[]            @relation("BranchScheduleCreator")
  activatedSchedules               BranchScheduleVersion[]            @relation("BranchScheduleActivator")
  endedSchedules                   BranchScheduleVersion[]            @relation("BranchScheduleEnder")
  createdSpecialHours              BranchSpecialHours[]               @relation("SpecialHoursCreator")
  activatedSpecialHours            BranchSpecialHours[]               @relation("SpecialHoursActivator")
  endedSpecialHours                BranchSpecialHours[]               @relation("SpecialHoursEnder")
  openedStaffShifts                StaffShift[]                       @relation("StaffShiftOpener")
  currentStaffShifts               StaffShift[]                       @relation("StaffShiftCurrentCashier")
  shiftResponsibilities            ShiftResponsibility[]              @relation("ShiftResponsibilityCashier")
  assignedShiftDuties              ShiftResponsibility[]              @relation("ShiftResponsibilityAssigner")
  endedShiftDuties                 ShiftResponsibility[]              @relation("ShiftResponsibilityEnder")
  submittedShiftCloses             ShiftClose[]                       @relation("ShiftCloseSubmitter")
  approvedShiftCloses              ShiftClose[]                       @relation("ShiftCloseApprover")
  createdOrders                    Order[]                            @relation("OrderCreator")
  orderEvents                      OrderEvent[]                       @relation("OrderEventActor")
  approvedTableConflicts           OrderTableConflict[]               @relation("OrderTableConflictApprover")
  createdOrderLines                OrderLine[]                        @relation("OrderLineCreator")
  sentOrderWaves                   OrderSendWave[]                    @relation("OrderSendWaveSender")
  preparationEvents                PreparationTicketEvent[]           @relation("PreparationTicketEventActor")
  approvedSentCancellations        OrderSentLineCancellation[]        @relation("SentLineCancellationApprover")
  assignedOrders                   Order[]                            @relation("OrderAssignedServer")
  movedOrderTables                 OrderTableMovement[]               @relation("OrderTableMovementActor")
  transferredOrderOwnership        OrderResponsibilityTransfer[]      @relation("OrderResponsibilityTransferActor")
  transferredOrdersFrom            OrderResponsibilityTransfer[]      @relation("OrderResponsibilityFromUser")
  transferredOrdersTo              OrderResponsibilityTransfer[]      @relation("OrderResponsibilityToUser")
  mergedOrders                     OrderMerge[]                       @relation("OrderMergeActor")
  splitOrders                      OrderSplit[]                       @relation("OrderSplitActor")
  createdPayments                  Payment[]                          @relation("PaymentCreator")
  paymentEvents                    PaymentEvent[]                     @relation("PaymentEventActor")
  paymentVerifications             PaymentVerification[]              @relation("PaymentVerifier")
  completedOrders                  Order[]                            @relation("OrderCompleter")
  createdReceipts                  Receipt[]                          @relation("ReceiptCreator")
  receiptReprints                  ReceiptReprint[]                   @relation("ReceiptReprintActor")
  createdPrintJobs                 PrintJob[]                         @relation("PrintJobCreator")
  fiscalDocuments                  FiscalDocument[]                   @relation("FiscalDocumentCreator")
  requestedRefunds                 Refund[]                           @relation("RefundRequester")
  approvedRefunds                  RefundApproval[]                   @relation("RefundApprover")
  resolvedRefunds                  Refund[]                           @relation("RefundResolver")
  requestedCashMovements           CashMovement[]                     @relation("CashMovementRequester")
  approvedCashMovements            CashMovementApproval[]             @relation("CashMovementApprover")
  createdRecipeVersions            RecipeVersion[]                    @relation("RecipeVersionCreator")
  activatedRecipeVersions          RecipeVersion[]                    @relation("RecipeVersionActivator")
  stockLedgerEntries               StockLedgerEntry[]                 @relation("StockLedgerActor")
  inventoryTransfers               InventoryTransfer[]                @relation("InventoryTransferActor")
  createdStockCounts               StockCount[]                       @relation("StockCountCreator")
  postedStockCounts                StockCount[]                       @relation("StockCountPoster")
  createdPurchaseOrders            PurchaseOrder[]                    @relation("PurchaseOrderCreator")
  submittedPurchaseOrders          PurchaseOrder[]                    @relation("PurchaseOrderSubmitter")
  cancelledPurchaseOrders          PurchaseOrder[]                    @relation("PurchaseOrderCanceller")
  postedGoodsReceipts              GoodsReceipt[]                     @relation("GoodsReceiptPoster")
  postedPurchaseReturns            PurchaseReturn[]                   @relation("PurchaseReturnPoster")
  createdDeductionPolicies         InventoryDeductionPolicyVersion[]  @relation("InventoryDeductionPolicyCreator")
  confirmedDeductionPolicies       InventoryDeductionPolicyVersion[]  @relation("InventoryDeductionPolicyConfirmer")
  activatedDeductionPolicies       InventoryDeductionPolicyVersion[]  @relation("InventoryDeductionPolicyActivator")
  createdConsumptionRoutes         InventoryConsumptionRouteVersion[] @relation("InventoryConsumptionRouteCreator")
  activatedConsumptionRoutes       InventoryConsumptionRouteVersion[] @relation("InventoryConsumptionRouteActivator")
  postedInventoryConsumptions      InventoryConsumption[]             @relation("InventoryConsumptionActor")
  reversedInventoryConsumptions    InventoryConsumptionReversal[]     @relation("InventoryConsumptionReversalActor")
  createdModifierRecipeEffects     ModifierRecipeEffectVersion[]      @relation("ModifierRecipeEffectCreator")
  activatedModifierRecipeEffects   ModifierRecipeEffectVersion[]      @relation("ModifierRecipeEffectActivator")
  createdBatchRecipeVersions       BatchRecipeVersion[]               @relation("BatchRecipeVersionCreator")
  activatedBatchRecipeVersions     BatchRecipeVersion[]               @relation("BatchRecipeVersionActivator")
  postedBatchProductions           BatchProduction[]                  @relation("BatchProductionActor")
  reversedBatchProductions         BatchProductionReversal[]          @relation("BatchProductionReversalActor")
  createdCriticalIngredientRules   CriticalIngredientRuleVersion[]    @relation("CriticalIngredientRuleCreator")
  confirmedCriticalIngredientRules CriticalIngredientRuleVersion[]    @relation("CriticalIngredientRuleConfirmer")
  activatedCriticalIngredientRules CriticalIngredientRuleVersion[]    @relation("CriticalIngredientRuleActivator")
  manualAvailabilityEvents         ManualAvailabilityEvent[]          @relation("ManualAvailabilityEventActor")
  syncCommandReceipts              SyncCommandReceipt[]
  syncCommandResolutions           SyncCommandResolution[]
  recordedOperationalEvidence      OperationalEvidence[]
  createdCustomerProfiles          CustomerProfile[]                  @relation("CustomerProfileCreator")
  anonymizedCustomerProfiles       CustomerProfile[]                  @relation("CustomerProfileAnonymizer")
  customerConsentEvents            CustomerConsentEvent[]             @relation("CustomerConsentActor")
  customerDataAccessEvents         CustomerDataAccessEvent[]          @relation("CustomerDataAccessActor")
  createdPrivacyRequests           PrivacyRequest[]                   @relation("PrivacyRequestCreator")
  verifiedPrivacyRequests          PrivacyRequest[]                   @relation("PrivacyRequestVerifier")
  completedPrivacyRequests         PrivacyRequest[]                   @relation("PrivacyRequestCompleter")
  privacyRequestEvents             PrivacyRequestEvent[]              @relation("PrivacyRequestEventActor")
  createdRetentionPolicies         RetentionPolicyVersion[]           @relation("RetentionPolicyCreator")
  activatedRetentionPolicies       RetentionPolicyVersion[]           @relation("RetentionPolicyActivator")
  revokedSessions                  Session[]                          @relation("SessionRevoker")
  acknowledgedSecurityAlerts       SecurityAlert[]                    @relation("SecurityAlertAcknowledger")
  resolvedSecurityAlerts           SecurityAlert[]                    @relation("SecurityAlertResolver")
  securityAlertEvents              SecurityAlertEvent[]
  createdAuditIntegrityBatches     AuditIntegrityBatch[]              @relation("AuditIntegrityBatchCreator")
  recordedPilotReadinessEvidence   PilotReadinessEvidence[]           @relation("PilotReadinessEvidenceRecorder")
  capturedPilotReadinessReviews    PilotReadinessReview[]             @relation("PilotReadinessReviewRecorder")
  mfaCredentials                   UserMfaCredential[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
}

model UserMfaCredential {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  status           MfaCredentialStatus @default(PENDING)
  secretCiphertext Bytes               @map("secret_ciphertext")
  revision         Int                 @default(1)
  activatedAt      DateTime?           @map("activated_at") @db.Timestamptz(3)
  disabledAt       DateTime?           @map("disabled_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  recoveryCodes MfaRecoveryCode[]

  @@index([organizationId, status])
  @@index([userId, status])
  @@map("user_mfa_credentials")
}

model MfaRecoveryCode {
  id           String    @id @default(uuid()) @db.Uuid
  credentialId String    @map("credential_id") @db.Uuid
  codeHash     String    @map("code_hash") @db.Char(64)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  credential UserMfaCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@unique([credentialId, codeHash])
  @@index([credentialId, usedAt])
  @@map("mfa_recovery_codes")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  scope          RoleScope @default(BRANCH)
  isSystem       Boolean   @default(false) @map("is_system")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  key         String @id @db.VarChar(120)
  description String @db.VarChar(240)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key") @db.VarChar(120)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  branchId         String?   @map("branch_id") @db.Uuid
  assignedById     String?   @map("assigned_by_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedById      String?   @map("revoked_by_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?   @map("revocation_reason") @db.VarChar(500)

  user       User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch     Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedBy User?   @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedBy  User?   @relation("RoleRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId, branchId, revokedAt])
  @@index([roleId, revokedAt])
  @@map("user_roles")
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  deviceId         String        @map("device_id") @db.Uuid
  tokenHash        String        @unique @map("token_hash") @db.Char(64)
  status           SessionStatus @default(ACTIVE)
  revision         Int           @default(1)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime      @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedById      String?       @map("revoked_by_id") @db.Uuid
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?       @map("revocation_reason") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  device    Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  revokedBy User?  @relation("SessionRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId, status, expiresAt])
  @@index([deviceId, status, expiresAt])
  @@index([revokedById, revokedAt])
  @@map("sessions")
}

