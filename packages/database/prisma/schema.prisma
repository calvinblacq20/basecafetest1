  ACTIVE
  CANCELLED
}

enum SpecialHoursKind {
  CLOSED
  CUSTOM_HOURS
}

enum SpecialHoursStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  CANCELLED
}

enum StaffShiftStatus {
