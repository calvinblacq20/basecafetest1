enum CashMovementType {
  PAID_IN
  PAID_OUT
  BANK_DROP
  CORRECTION
}

enum CashMovementDirection {
  IN
  OUT
}

enum CashMovementStatus {
  AWAITING_APPROVAL
  POSTED
  REJECTED
}

enum PaymentEventType {
  CREATED
  VERIFICATION_CONFIRMED
  VERIFICATION_FAILED
  CANCELLED
}

enum FiscalDocumentStatus {
  NOT_REQUIRED
