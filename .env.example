DATABASE_URL="postgresql://base_cafe:base_cafe_dev@localhost:5432/base_cafe?schema=public"
APP_VERSION="0.1.0"
PORT=3100
LOG_LEVEL=info
SESSION_TTL_MINUTES=480
# Comma-separated browser origins only; production has no implicit origins.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Disabled until the owner/security/offline policy is approved. An enabled lease
# never persists a bearer token and cannot sync without a new password session.
OFFLINE_UNLOCK_ENABLED=false
OFFLINE_UNLOCK_MAX_MINUTES=240
OFFLINE_UNLOCK_MIN_PIN_LENGTH=6
OFFLINE_UNLOCK_MAX_FAILED_ATTEMPTS=5
OFFLINE_UNLOCK_LOCKOUT_SECONDS=300

# Login throttling defaults. Set a unique 32+ character pepper in every deployed
# environment. TRUST_PROXY_HOPS must match the number of trusted reverse proxies.
AUTH_THROTTLE_PEPPER=""
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_LOGIN_ACCOUNT_MAX_FAILURES=5
AUTH_LOGIN_DEVICE_MAX_FAILURES=20
AUTH_LOGIN_IP_MAX_FAILURES=30
TRUST_PROXY_HOPS=0

# Development-only bootstrap account. Use unique secrets and remove them from
# the runtime environment after the first administrator is provisioned.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Operational recovery remains disabled until storage ownership, encryption-key
# custody, retention, RPO/RTO, scheduling, and incident contacts are approved.
# BACKUP_DIRECTORY must be an absolute non-root directory. Generate a distinct
# 32-byte key per environment and supply it as base64 through secret management.
BACKUP_ENABLED=false
BACKUP_DIRECTORY=""
BACKUP_ENCRYPTION_KEY_B64=""
BACKUP_RETENTION_DAYS=""
BACKUP_SOURCE_LABEL=""
BACKUP_SCHEMA_VERSION=""
BACKUP_MAX_AGE_MINUTES=""
PG_DUMP_PATH="pg_dump"
PG_RESTORE_PATH="pg_restore"
PSQL_PATH="psql"

# Restore drills are destructive to the explicitly named isolated target only.
# The command refuses to run unless RESTORE_EXECUTE=true and the confirmation
# value exactly matches RESTORE_TARGET_LABEL. Never point this at production.
RESTORE_EXECUTE=false
RESTORE_MANIFEST_PATH=""
RESTORE_DATABASE_URL=""
RESTORE_TARGET_LABEL=""
RESTORE_CONFIRM_TARGET=""

# Customer PII uses an AES-256-GCM versioned key ring and a separate HMAC key.
# Keep these blank until secrets are provisioned. Example shape only:
# CUSTOMER_PII_KEYS_JSON={"v1":"<base64-encoded-32-byte-key>"}
CUSTOMER_PII_ACTIVE_KEY_VERSION=""
CUSTOMER_PII_KEYS_JSON=""
CUSTOMER_PII_BLIND_INDEX_KEY_B64=""

# External alert delivery remains unavailable until incident contacts, routing,
# escalation authority, and response targets are confirmed. This flag documents
# the safe default; the current implementation persists internal alerts only.
SECURITY_EXTERNAL_ALERTS_ENABLED=false

# Browser-safe API origin for the admin web client. Never expose secrets through a
# NEXT_PUBLIC variable.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3100/api/v1"

# These lifecycle actions remain disabled until the owner approves the matching
# policy and operating procedure. Withdrawals are always accepted.
PRIVACY_MARKETING_ENABLED=false
PRIVACY_RETENTION_ACTIVATION_ENABLED=false
PRIVACY_ANONYMIZATION_ENABLED=false

# Optional administrator TOTP is disabled until policy is confirmed. Enrollment
# and enforcement are separate controls; enforcement additionally requires a
# secret-management supplied 32-byte encryption key.
MFA_ENROLLMENT_ENABLED=false
MFA_ENFORCEMENT_ENABLED=false
MFA_ENCRYPTION_KEY_B64=""

# External integrations are provider-neutral and disabled. Fictional adapters
# are test-only, require ALLOW_FICTIONAL_INTEGRATION_ADAPTERS=true, and are
# rejected when NODE_ENV=production.
ALLOW_FICTIONAL_INTEGRATION_ADAPTERS=false
PSP_ADAPTER=disabled
GRA_FISCAL_ADAPTER=disabled
PRINTER_ADAPTER=browser
NOTIFICATION_ADAPTER=disabled
